# Web API 仅发布到宿主机回环地址，由宿主机 Nginx 提供 HTTPS。
ZENPROXY_HOST_PORT=3000

POSTGRES_DB=zenproxy
POSTGRES_USER=zenproxy
POSTGRES_PASSWORD=change-me

ZENPROXY_ADMIN_PASSWORD=change-me
ZENPROXY_SUBSCRIPTION_PASSWORD=change-subscription-password
ZENPROXY_OAUTH_CLIENT_ID=
ZENPROXY_OAUTH_CLIENT_SECRET=
ZENPROXY_OAUTH_REDIRECT_URI=http://localhost/api/auth/callback
ZENPROXY_OAUTH_REQUIRED_GUILD_ID=

RUST_LOG=zenproxy=info,tower_http=info

# Proxy pool listener (SOCKS5+HTTP on same port, auto-detect).
# 远程客户端连接宿主机的 ZENPROXY_PROXY_PORT；容器内部固定监听 1080。
# Format: user:pass@container_listen_host:port
# Filters via username suffix at connect time: user-country-US-residential:pass
ZENPROXY_PROXY_BIND_IP=0.0.0.0
ZENPROXY_PROXY_PORT=50089
ZENPROXY_PROXY_LISTENER=myuser:replace-with-a-strong-password@0.0.0.0:1080

# 独立代理账号认证。迁移期使用 hybrid 保留上面的旧共享账号。
ZENPROXY_PROXY_AUTH_MODE=hybrid
# 使用 `openssl rand -hex 32` 生成；更换此值会让所有独立账号密码失效。
ZENPROXY_PROXY_CREDENTIAL_SECRET=replace-with-64-random-hex-characters
# 用户页面生成连接 URL 时使用的真实公网入口；Cloudflare 代理域名不能用于该 TCP 端口。
ZENPROXY_PUBLIC_PROXY_HOST=SERVER_IP
ZENPROXY_PUBLIC_PROXY_PORT=50089
